# ==============================================================================
#  Case Creator + Case Lookup - files git should never track
#
#  Case .zip files ARE tracked deliberately, as worked examples. Everything
#  below is either OS clutter, locally generated runtime state, or scraper
#  output that is reproduced by running the tool.
# ==============================================================================

# --- Windows / macOS clutter --------------------------------------------------
desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
.DS_Store
._*

# --- Runtime state, written by the app on your machine ------------------------
# Both folders are created automatically on first save, so a fresh clone does
# not need them to exist. Your backups and orphaned bins are yours alone.
Backup/
OrphanedBins/

# --- Image Scraper output -----------------------------------------------------
# Regenerated by running catalog_scraper.py. The scraped photos belong to the
# sites they came from, so they are kept local rather than republished.
Tools/Image Scraper/images/
Tools/Image Scraper/_icrawler_tmp/

# --- Dev scratch screenshots --------------------------------------------------
# Only search.png, builder.png and thumbnail-editor.png are used by the README.
.github/screenshots/*-check.png
.github/screenshots/0[12]-*.png
.github/screenshots/hover-test*.png
.github/screenshots/hover-verify.png
.github/screenshots/full*.png
.github/screenshots/3d-crop*.png
.github/screenshots/label-check*.png
.github/screenshots/uniform-check*.png

# --- Editor / tooling ---------------------------------------------------------
.vscode/
__pycache__/
*.py[cod]
.venv/
venv/
